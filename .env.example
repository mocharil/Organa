# ============================================================
# Organa multi-LLM configuration
# ============================================================
# Secrets stay server-side. The browser only sees provider/model names.
# ORGANA_LLM_PROVIDER: auto | vertex | gemini | openai | anthropic | dry-run
# "auto" prefers Vertex AI, then Gemini API, OpenAI, Anthropic, then dry-run.
ORGANA_LLM_PROVIDER=auto

# Optional workspace-level model overrides. Leave blank to use provider defaults.
ORGANA_LLM_MODEL=
ORGANA_PLANNER_MODEL=

# ============================================================
# Option A: Gemini on Vertex AI, recommended for the AI Builder Cup
# ============================================================
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_PLANNER_MODEL=gemini-2.5-flash

# Local service-account authentication. Prefer the standard path option:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# If your hosting environment cannot mount a file, the server also supports ONE of:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=<base64-encoded-json>
#
# On Cloud Run, do NOT ship a JSON key if you can avoid it. Attach a runtime
# service account with Vertex AI permissions and let Application Default Credentials work.

# ============================================================
# Option B: Gemini Developer API / AI Studio key
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PLANNER_MODEL=gemini-2.5-flash

# ============================================================
# Option C: OpenAI Responses API
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PLANNER_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# Option D: Anthropic Messages API
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ============================================================
# Persistence
# ============================================================
# json (local default) or firestore (Cloud Run recommended)
ORGANA_STORAGE=json
FIRESTORE_DATABASE_ID=(default)

# Force deterministic no-cost demo mode even when credentials are present.
# ORGANA_DRY_RUN=1
DRY_RUN_DELAY_MS=350

# Cloud Run supplies PORT automatically.
# PORT=8080
# HOST=0.0.0.0

# Demo helper. Disable on a public production deployment after judging/demo.
ORGANA_ENABLE_DEMO_RESET=1
